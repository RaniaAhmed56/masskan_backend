# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Everything here has a safe default in config/settings/dev.py, so local
# development works even with an empty .env — these mostly matter in prod.

# --- Core -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=api.masskan.app

# --- Database (config.settings.prod only — dev uses SQLite) -----------
DB_NAME=masskan
DB_USER=masskan
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Frontend / CORS ----------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Email (see apps/common/services/notifications.py) ----------------
DEFAULT_FROM_EMAIL=no-reply@masskan.app
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- Payments (see apps/subscriptions/services/payments.py) -----------
# Not wired to a real provider yet — kept here so switching to Stripe/Paymob
# later is a config change, not a code change.
PAYMENTS_PROVIDER=stub
STRIPE_SECRET_KEY=
PAYMOB_API_KEY=
